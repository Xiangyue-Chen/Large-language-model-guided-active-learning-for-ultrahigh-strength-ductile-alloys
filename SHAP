@dataclass(frozen=True)
class TargetConfig:
    target: str
    physical_count: int
    phase_count: int
    physical_selection_path: Path
    phase_selection_path: Path
    output_dir: Path
    model_source_dir: Path


@dataclass
class TargetDataset:
    features: pd.DataFrame
    target: np.ndarray
    excel_rows: np.ndarray
    manifest: pd.DataFrame
    source_indices: np.ndarray


@dataclass
class OOFShapResult:
    prediction: np.ndarray
    prediction_std: np.ndarray
    shap_values: np.ndarray
    base_value: np.ndarray
    coverage: np.ndarray
    model_registry: pd.DataFrame
    seed_metrics: pd.DataFrame
    ensemble_metrics: dict[str, float]
    mean_seed_metrics: dict[str, float]
    max_additivity_error: float
    seed_predictions: np.ndarray


