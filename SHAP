def _normalized_feature_colors(values: np.ndarray) -> tuple[np.ndarray, np.ndarray]:
    numeric = np.asarray(values, dtype=float)
    finite = np.isfinite(numeric)
    colors = np.full(len(numeric), 0.5, dtype=float)
    if finite.any():
        lower, upper = np.nanpercentile(numeric[finite], [5, 95])
        if upper > lower:
            colors[finite] = np.clip((numeric[finite] - lower) / (upper - lower), 0.0, 1.0)
        else:
            colors[finite] = 0.5
    return colors, finite


