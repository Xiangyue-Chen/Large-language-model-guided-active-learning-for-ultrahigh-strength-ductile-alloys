def _style_excel_workbook(writer: pd.ExcelWriter) -> None:
    for worksheet in writer.book.worksheets:
        worksheet.freeze_panes = "A2"
        worksheet.auto_filter.ref = worksheet.dimensions
        worksheet.sheet_view.showGridLines = False
        for cell in worksheet[1]:
            header_font = copy(cell.font)
            header_font.bold = True
            cell.font = header_font
        for column_cells in worksheet.iter_cols(
            min_col=1,
            max_col=min(worksheet.max_column, 20),
            min_row=1,
            max_row=min(worksheet.max_row, 200),
        ):
            width = min(
                42,
                max(10, max(len(str(cell.value)) if cell.value is not None else 0 for cell in column_cells) + 2),
            )
            worksheet.column_dimensions[column_cells[0].column_letter].width = width


def export_analysis(
    result: OOFShapResult,
    dataset: TargetDataset,
    config: TargetConfig,
) -> dict[str, Any]:
    output_dir = Path(config.output_dir)
    output_dir.mkdir(parents=True, exist_ok=True)
    importance = build_global_importance(result, dataset)
    plot_range_audit = build_plot_range_audit(dataset)
    feature_names = dataset.manifest["feature"].astype(str).tolist()
    seeds = result.seed_metrics["seed"].astype(int).tolist()
    prediction_table = pd.DataFrame(
        {
            "source_index_zero_based": dataset.source_indices,
            "original_excel_row": dataset.excel_rows,
            "measured": dataset.target,
            "mean_oof_prediction": result.prediction,
            "std_oof_prediction_across_seeds": result.prediction_std,
            "residual_measured_minus_predicted": dataset.target - result.prediction,
            "absolute_error": np.abs(dataset.target - result.prediction),
            "mean_base_value": result.base_value,
            "oof_explanation_count": result.coverage,
        }
    )
    for seed_index, seed in enumerate(seeds):
        prediction_table[f"oof_prediction_seed_{seed}"] = result.seed_predictions[seed_index]
    shap_table = pd.DataFrame(
        result.shap_values,
        columns=[f"SHAP::{name}" for name in feature_names],
    )
    shap_table.insert(0, "original_excel_row", dataset.excel_rows)
    value_table = dataset.features.copy()
    value_table.columns = [f"VALUE::{name}" for name in feature_names]
    value_table.insert(0, "original_excel_row", dataset.excel_rows)
    reconstructed = result.base_value + result.shap_values.sum(axis=1)
    additivity_table = pd.DataFrame(
        {
            "original_excel_row": dataset.excel_rows,
            "mean_oof_prediction": result.prediction,
            "mean_base_value": result.base_value,
            "sum_mean_shap": result.shap_values.sum(axis=1),
            "reconstructed_prediction": reconstructed,
            "absolute_additivity_error": np.abs(result.prediction - reconstructed),
        }
    )

    route_counts = dataset.manifest["route"].value_counts().to_dict()
    summary: dict[str, Any] = {
        "target": config.target,
        "sample_count": int(len(dataset.target)),
        "feature_count": int(dataset.features.shape[1]),
        "base_feature_count": int(route_counts.get("base", 0)),
        "physical_feature_count": int(route_counts.get("physical", 0)),
        "phase_feature_count": int(route_counts.get("phase", 0)),
        "model_count": int(len(result.model_registry)),
        "cv_seeds": seeds,
        "fold_count_per_seed": int(result.model_registry["fold"].nunique()),
        "oof_explanations_per_row": int(result.coverage[0]),
        "ensemble_oof_r2": float(result.ensemble_metrics["r2"]),
        "ensemble_oof_rmse": float(result.ensemble_metrics["rmse"]),
        "ensemble_oof_mae": float(result.ensemble_metrics["mae"]),
        **result.mean_seed_metrics,
