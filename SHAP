def load_selected_prefix(
    path: Path | str,
    count: int,
    count_column: str = "round",
) -> list[str]:
    source = Path(path)
    if not source.exists():
        raise FileNotFoundError(source)
    requested = int(count)
    if requested < 0:
        raise ValueError("selected prefix count must be non-negative")

    table = pd.read_csv(source)
    required = {count_column, "selected_feature"}
    missing = required.difference(table.columns)
    if missing:
        raise KeyError(f"selection path is missing columns: {sorted(missing)}")
    numeric_count = pd.to_numeric(table[count_column], errors="raise").astype(int)
    table = table.assign(_selection_count=numeric_count)
    rows = table.loc[
        table["_selection_count"].between(1, requested, inclusive="both")
    ].sort_values("_selection_count")
    actual_counts = rows["_selection_count"].tolist()
    expected_counts = list(range(1, requested + 1))
    if actual_counts != expected_counts:
        raise ValueError(
            f"selection rounds must be contiguous from 1 to {requested}; "
            f"got {actual_counts}"
        )
    names = rows["selected_feature"].astype(str).tolist()
    if len(set(names)) != len(names):
        raise ValueError("selected prefix contains duplicate feature names")
    return names


def build_feature_manifest(
    base_names: Sequence[str],
    physical_names: Sequence[str],
    phase_names: Sequence[str],
) -> pd.DataFrame:
    base = [str(name) for name in base_names]
    physical = [str(name) for name in physical_names]
    phase = [str(name) for name in phase_names]
    names = [*base, *physical, *phase]
    if len(set(names)) != len(names):
        duplicates = sorted({name for name in names if names.count(name) > 1})
        raise ValueError(f"feature manifest contains duplicate names: {duplicates}")
    routes = ["base"] * len(base) + ["physical"] * len(physical) + ["phase"] * len(phase)
    return pd.DataFrame(
        {
            "position": np.arange(1, len(names) + 1, dtype=int),
            "feature": names,
            "model_feature": [f"feature_{index:03d}" for index in range(len(names))],
            "route": routes,
        }
    )


def build_target_dataset(config: TargetConfig) -> TargetDataset:
    dependencies = _pipeline_dependencies()
    source_frame, bundle = dependencies["load_workbook_data"](
        Path(dependencies["DATA_FILE"])
    )
    if config.target not in {"yield", "elongation"}:
        raise ValueError(f"unsupported target: {config.target}")
    valid = np.asarray(bundle.valid_masks[config.target], dtype=bool)
    source_indices = np.flatnonzero(valid)
    physical_prefix, _ = dependencies["load_physical_prefix"](
        config.physical_selection_path,
        config.physical_count,
        bundle.physical_names,
    )
    phase_prefix = load_selected_prefix(
        config.phase_selection_path,
        config.phase_count,
        count_column="round",
    )
    starting_matrix = dependencies["make_starting_matrix"](
        bundle.base_matrix[valid],
        bundle.physical_matrix[valid],
        physical_prefix,
        bundle.physical_names,
    )
    phase_column = str(dependencies["PHASE_COLUMN"])
    if phase_column not in source_frame.columns:
        raise KeyError(f"source workbook is missing Phase column: {phase_column}")
    _, target_candidates, _, _ = dependencies["build_combined_candidates"](
        source_frame[phase_column],
        valid,
        MIN_POSITIVE_COUNT,
    )
    missing_phase = [name for name in phase_prefix if name not in target_candidates.columns]
    if missing_phase:
        raise KeyError(f"frozen Phase features are unavailable: {missing_phase}")
    phase_matrix = target_candidates.loc[:, phase_prefix].to_numpy(dtype=float)
    matrix = np.column_stack([starting_matrix, phase_matrix])
    manifest = build_feature_manifest(
        bundle.base_names,
        physical_prefix,
        phase_prefix,
    )
    expected_dimension = 47 if config.target == "yield" else 53
    if matrix.shape[1] != expected_dimension:
        raise ValueError(
            f"{config.target} frozen feature dimension must be {expected_dimension}, "
            f"got {matrix.shape[1]}"
        )
    if len(manifest) != matrix.shape[1]:
        raise RuntimeError("feature manifest and matrix dimensions do not match")
    feature_frame = pd.DataFrame(
        matrix,
        columns=manifest["feature"].astype(str).tolist(),
    )
    target = np.asarray(bundle.targets[config.target][valid], dtype=float)
    if not np.isfinite(target).all():
        raise ValueError("target contains non-finite values after validity filtering")
    return TargetDataset(
        features=feature_frame,
        target=target,
        excel_rows=np.asarray(bundle.excel_rows[valid], dtype=int),
        manifest=manifest,
        source_indices=source_indices.astype(int),
    )


def validate_oof_coverage(coverage: np.ndarray, expected: int) -> None:
    values = np.asarray(coverage, dtype=int)
    expected_count = int(expected)
    invalid = np.flatnonzero(values != expected_count)
    if invalid.size:
        examples = invalid[:10].tolist()
        raise ValueError(
            f"OOF coverage must equal {expected_count} for every row; "
            f"invalid row positions: {examples}"
        )


def _additivity_tolerance(prediction: np.ndarray) -> np.ndarray:
    return 1e-8 * np.maximum(1.0, np.abs(np.asarray(prediction, dtype=float)))


def aggregate_prediction_contributions(
    predictions: np.ndarray,
    contributions: np.ndarray,
) -> EnsembleContribution:
    prediction_matrix = np.asarray(predictions, dtype=float)
    contribution_cube = np.asarray(contributions, dtype=float)
    if prediction_matrix.ndim != 2:
        raise ValueError("predictions must have shape (model_count, row_count)")
    if contribution_cube.ndim != 3:
        raise ValueError(
            "contributions must have shape (model_count, row_count, feature_count + 1)"
        )
    if contribution_cube.shape[:2] != prediction_matrix.shape:
        raise ValueError("prediction and contribution model/row dimensions must match")
    if contribution_cube.shape[2] < 2:
        raise ValueError("contributions must contain at least one feature and one base value")
    if not np.isfinite(prediction_matrix).all() or not np.isfinite(contribution_cube).all():
        raise ValueError("predictions and contributions must be finite")

    reconstructed = contribution_cube.sum(axis=2)
    model_errors = np.abs(prediction_matrix - reconstructed)
    if np.any(model_errors > _additivity_tolerance(prediction_matrix)):
        maximum = float(model_errors.max())
        raise ValueError(f"model SHAP additivity check failed; maximum error={maximum:.6g}")

    mean_prediction = prediction_matrix.mean(axis=0)
    mean_shap = contribution_cube[:, :, :-1].mean(axis=0)
    mean_base = contribution_cube[:, :, -1].mean(axis=0)
    ensemble_error = np.abs(mean_prediction - (mean_base + mean_shap.sum(axis=1)))
    maximum_error = float(ensemble_error.max(initial=0.0))
    if np.any(ensemble_error > _additivity_tolerance(mean_prediction)):
        raise ValueError(
            f"ensemble SHAP additivity check failed; maximum error={maximum_error:.6g}"
        )
    return EnsembleContribution(
        prediction=mean_prediction,
        shap_values=mean_shap,
        base_value=mean_base,
        max_additivity_error=maximum_error,
    )


def validate_prediction_schema(
    frame: pd.DataFrame,
    feature_names: Sequence[str],
) -> pd.DataFrame:
    required = [str(name) for name in feature_names]
    if len(set(required)) != len(required):
        raise ValueError("prediction feature manifest contains duplicate names")
    missing = [name for name in required if name not in frame.columns]
    if missing:
        raise KeyError(f"prediction input is missing required features: {missing}")
    original = frame.loc[:, required]
    selected = original.apply(pd.to_numeric, errors="coerce")
    invalid = original.notna() & selected.isna()
    for column in required:
        invalid[column] &= original[column].astype(str).str.strip().ne("")
    if invalid.to_numpy().any():
        row_index, column_index = np.argwhere(invalid.to_numpy())[0]
        raise ValueError(
            "prediction input contains a non-numeric feature value at "
            f"row={original.index[row_index]}, feature={required[column_index]}"
        )
    return selected.astype(float)


