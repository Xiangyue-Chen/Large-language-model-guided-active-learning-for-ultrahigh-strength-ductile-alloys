def predict_saved_ensemble(
    result_dir: Path | str,
    prepared_features: pd.DataFrame,
    model_source_dir: Path | str | None = None,
) -> SavedEnsemblePrediction:
    directory = Path(result_dir)
    manifest_path = directory / "feature_manifest.csv"
    registry_directory = (
        Path(model_source_dir) if model_source_dir is not None else directory
    )
    registry_path = registry_directory / "model_registry.csv"
    if not manifest_path.exists():
        raise FileNotFoundError(manifest_path)
    if not registry_path.exists():
        raise FileNotFoundError(registry_path)
    manifest = pd.read_csv(manifest_path)
    required_manifest_columns = {"feature", "model_feature", "position"}
    missing_manifest = required_manifest_columns.difference(manifest.columns)
    if missing_manifest:
        raise KeyError(f"feature manifest is missing columns: {sorted(missing_manifest)}")
    manifest = manifest.sort_values("position")
    feature_names = manifest["feature"].astype(str).tolist()
    model_names = manifest["model_feature"].astype(str).tolist()
    validated = validate_prediction_schema(prepared_features, feature_names)
    model_frame = validated.copy()
    model_frame.columns = model_names
    registry = pd.read_csv(registry_path)
    if "model_path" not in registry.columns or registry.empty:
        raise ValueError("model registry does not contain saved models")

    predictions: list[np.ndarray] = []
    contributions: list[np.ndarray] = []
    for raw_path in registry["model_path"].astype(str):
        model_path = _resolve_registered_model_path(raw_path, registry_directory)
        artifact = joblib.load(model_path)
        if [str(value) for value in artifact.get("feature_names", [])] != feature_names:
            raise ValueError(f"saved model feature order mismatch: {model_path}")
        if [str(value) for value in artifact.get("model_feature_names", [])] != model_names:
            raise ValueError(f"saved model internal feature order mismatch: {model_path}")
        model = artifact["model"]
        prediction = np.asarray(model.predict(model_frame), dtype=float)
        contribution = np.asarray(
            model.predict(model_frame, pred_contrib=True), dtype=float
        )
        predictions.append(prediction)
        contributions.append(contribution)
    prediction_matrix = np.stack(predictions, axis=0)
    contribution_cube = np.stack(contributions, axis=0)
    aggregate = aggregate_prediction_contributions(
        prediction_matrix,
        contribution_cube,
    )
    return SavedEnsemblePrediction(
        prediction=aggregate.prediction,
        prediction_std=prediction_matrix.std(axis=0, ddof=0),
        shap_values=aggregate.shap_values,
        base_value=aggregate.base_value,
        max_additivity_error=aggregate.max_additivity_error,
        model_count=prediction_matrix.shape[0],
    )


def run_target_analysis(config: TargetConfig) -> dict[str, Any]:
    dataset = build_target_dataset(config)
    result = load_oof_shap_from_saved_models(dataset, config)
    summary = export_analysis(result, dataset, config)
    print(json.dumps(summary, ensure_ascii=False, indent=2))
    return summary
