def regression_metrics(y_true: np.ndarray, y_pred: np.ndarray) -> dict[str, float]:
    true = np.asarray(y_true, dtype=float)
    predicted = np.asarray(y_pred, dtype=float)
    return {
        "r2": float(r2_score(true, predicted)),
        "mae": float(mean_absolute_error(true, predicted)),
        "rmse": float(math.sqrt(mean_squared_error(true, predicted))),
    }


def _resolve_registered_model_path(raw_path: object, source_dir: Path) -> Path:
    model_path = Path(str(raw_path))
    if model_path.exists():
        return model_path.resolve()
    fallback = source_dir / "models" / model_path.name
    if fallback.exists():
        return fallback.resolve()
    raise FileNotFoundError(model_path)


def _validate_saved_artifact_schema(
    artifact: dict[str, Any],
    dataset: TargetDataset,
    config: TargetConfig,
    seed: int,
    fold: int,
) -> tuple[np.ndarray, np.ndarray]:
    required = {
        "model",
        "target",
        "seed",
        "fold",
        "feature_names",
        "model_feature_names",
        "feature_manifest",
        "train_indices",
        "test_indices",
        "train_excel_rows",
        "test_excel_rows",
    }
    missing = required.difference(artifact)
    if missing:
        raise KeyError(f"saved model artifact is missing keys: {sorted(missing)}")
    if str(artifact["target"]) != config.target:
        raise ValueError("saved model target does not match requested target")
    if int(artifact["seed"]) != seed or int(artifact["fold"]) != fold:
        raise ValueError("saved model seed/fold does not match model registry")

    feature_names = dataset.manifest["feature"].astype(str).tolist()
    model_names = dataset.manifest["model_feature"].astype(str).tolist()
    if [str(value) for value in artifact["feature_names"]] != feature_names:
        raise ValueError("saved model feature order does not match frozen manifest")
    if [str(value) for value in artifact["model_feature_names"]] != model_names:
        raise ValueError("saved model internal feature order does not match frozen manifest")
    artifact_manifest = pd.DataFrame(artifact["feature_manifest"])
    manifest_columns = ["position", "feature", "model_feature", "route"]
    if any(column not in artifact_manifest.columns for column in manifest_columns):
        raise ValueError("saved model feature manifest is incomplete")
    left = artifact_manifest.loc[:, manifest_columns].reset_index(drop=True).astype(str)
    right = dataset.manifest.loc[:, manifest_columns].reset_index(drop=True).astype(str)
    if not left.equals(right):
        raise ValueError("saved model feature manifest does not match current dataset")

    sample_count = len(dataset.target)
    train_indices = np.asarray(artifact["train_indices"], dtype=int)
    test_indices = np.asarray(artifact["test_indices"], dtype=int)
    for name, indices in (("train", train_indices), ("test", test_indices)):
        if indices.ndim != 1 or len(np.unique(indices)) != len(indices):
            raise ValueError(f"saved model {name} indices must be one-dimensional and unique")
        if indices.size == 0 or indices.min() < 0 or indices.max() >= sample_count:
            raise ValueError(f"saved model {name} indices are outside the dataset")
    if np.intersect1d(train_indices, test_indices).size:
        raise ValueError("saved model train and test indices overlap")
    if len(train_indices) + len(test_indices) != sample_count:
        raise ValueError("saved model train/test indices do not cover the dataset")
    if not np.array_equal(
        np.sort(np.concatenate([train_indices, test_indices])),
        np.arange(sample_count, dtype=int),
    ):
        raise ValueError("saved model train/test indices are not a full partition")
    if not np.array_equal(
        np.asarray(artifact["train_excel_rows"], dtype=int),
        np.asarray(dataset.excel_rows[train_indices], dtype=int),
    ):
        raise ValueError("saved model training Excel rows do not match the dataset")
    if not np.array_equal(
        np.asarray(artifact["test_excel_rows"], dtype=int),
        np.asarray(dataset.excel_rows[test_indices], dtype=int),
    ):
        raise ValueError("saved model test Excel rows do not match the dataset")
    return train_indices, test_indices


def load_oof_shap_from_saved_models(
    dataset: TargetDataset,
    config: TargetConfig,
    expected_seeds: Sequence[int] = CV_SEEDS,
    expected_n_splits: int = N_SPLITS,
) -> OOFShapResult:
    seed_order = tuple(int(seed) for seed in expected_seeds)
    if not seed_order or len(set(seed_order)) != len(seed_order):
        raise ValueError("expected seeds must be non-empty and unique")
    fold_count = int(expected_n_splits)
    if fold_count < 2:
        raise ValueError("expected_n_splits must be at least 2")
    features = dataset.features.copy()
    target = np.asarray(dataset.target, dtype=float)
    if len(features) != len(target):
        raise ValueError("feature and target row counts differ")
    if len(dataset.manifest) != features.shape[1]:
        raise ValueError("feature manifest does not match feature matrix width")
    expected_names = dataset.manifest["feature"].astype(str).tolist()
    if features.columns.astype(str).tolist() != expected_names:
        raise ValueError("feature matrix columns do not match the manifest order")

    model_names = dataset.manifest["model_feature"].astype(str).tolist()
    model_frame = features.copy()
    model_frame.columns = model_names
    sample_count, feature_count = model_frame.shape
    source_dir = Path(config.model_source_dir)
    registry_path = source_dir / "model_registry.csv"
    if not registry_path.exists():
        raise FileNotFoundError(registry_path)
    source_registry = pd.read_csv(registry_path)
    required_registry = {"target", "seed", "fold", "model_path"}
    missing_registry = required_registry.difference(source_registry.columns)
    if missing_registry:
        raise KeyError(f"model registry is missing columns: {sorted(missing_registry)}")
    if source_registry.empty:
        raise ValueError("model registry is empty")
    source_registry["seed"] = pd.to_numeric(source_registry["seed"], errors="raise").astype(int)
    source_registry["fold"] = pd.to_numeric(source_registry["fold"], errors="raise").astype(int)
    if source_registry.duplicated(["seed", "fold"]).any():
        raise ValueError("model registry contains duplicate seed/fold records")
    expected_pairs = {
        (seed, fold)
        for seed in seed_order
        for fold in range(1, fold_count + 1)
    }
    actual_pairs = set(zip(source_registry["seed"], source_registry["fold"]))
    if actual_pairs != expected_pairs:
        missing_pairs = sorted(expected_pairs.difference(actual_pairs))
        unexpected_pairs = sorted(actual_pairs.difference(expected_pairs))
        raise ValueError(
            "model registry seed/fold coverage mismatch; "
            f"missing={missing_pairs}, unexpected={unexpected_pairs}"
        )
    if not source_registry["target"].astype(str).eq(config.target).all():
        raise ValueError("model registry contains a different target")
    source_registry = source_registry.sort_values(["seed", "fold"]).reset_index(drop=True)

    prediction_sum = np.zeros(sample_count, dtype=float)
    prediction_square_sum = np.zeros(sample_count, dtype=float)
    shap_sum = np.zeros((sample_count, feature_count), dtype=float)
    base_sum = np.zeros(sample_count, dtype=float)
    coverage = np.zeros(sample_count, dtype=int)
    seed_predictions = np.full((len(seed_order), sample_count), np.nan, dtype=float)
    registry_rows: list[dict[str, Any]] = []
    seed_index_by_value = {seed: index for index, seed in enumerate(seed_order)}

    for _, registry_row in source_registry.iterrows():
        seed = int(registry_row["seed"])
        fold = int(registry_row["fold"])
        seed_index = seed_index_by_value[seed]
        model_path = _resolve_registered_model_path(
            registry_row["model_path"], source_dir
        )
        artifact = joblib.load(model_path)
        if not isinstance(artifact, dict):
            raise TypeError(f"saved model artifact must be a dictionary: {model_path}")
        train_indices, test_indices = _validate_saved_artifact_schema(
            artifact, dataset, config, seed, fold
        )
        model = artifact["model"]
        test_frame = model_frame.iloc[test_indices]
        prediction = np.asarray(model.predict(test_frame), dtype=float)
        contribution = np.asarray(
            model.predict(test_frame, pred_contrib=True),
            dtype=float,
        )
        if prediction.shape != (len(test_indices),):
            raise RuntimeError("saved model prediction shape does not match test rows")
        if contribution.shape != (len(test_indices), feature_count + 1):
            raise RuntimeError(
                "native TreeSHAP contribution shape does not match feature count"
            )
        fold_contribution = aggregate_prediction_contributions(
            prediction[None, :],
            contribution[None, :, :],
        )
        seed_predictions[seed_index, test_indices] = prediction
        prediction_sum[test_indices] += prediction
        prediction_square_sum[test_indices] += prediction**2
        shap_sum[test_indices] += contribution[:, :-1]
        base_sum[test_indices] += contribution[:, -1]
        coverage[test_indices] += 1

        fold_metrics = regression_metrics(target[test_indices], prediction)
        registry_record = registry_row.to_dict()
        registry_record.update(
            {
                "model_path": str(model_path),
                "source_model_path": str(model_path),
                "train_count": int(len(train_indices)),
                "test_count": int(len(test_indices)),
                "loaded_test_r2": fold_metrics["r2"],
                "loaded_test_mae": fold_metrics["mae"],
                "loaded_test_rmse": fold_metrics["rmse"],
                "max_additivity_error": fold_contribution.max_additivity_error,
            }
        )
        registry_rows.append(registry_record)

    seed_rows: list[dict[str, Any]] = []
    for seed_index, seed in enumerate(seed_order):
        if not np.isfinite(seed_predictions[seed_index]).all():
            raise RuntimeError(f"seed {seed} does not provide exactly one OOF prediction per row")
        seed_rows.append(
            {
                "target": config.target,
                "seed": int(seed),
                **regression_metrics(target, seed_predictions[seed_index]),
            }
        )

    validate_oof_coverage(coverage, expected=len(seed_order))
    prediction = prediction_sum / coverage
    prediction_variance = np.maximum(
        prediction_square_sum / coverage - prediction**2,
        0.0,
    )
    prediction_std = np.sqrt(prediction_variance)
    shap_values = shap_sum / coverage[:, None]
    base_value = base_sum / coverage
    additivity_error = np.abs(prediction - (base_value + shap_values.sum(axis=1)))
    maximum_error = float(additivity_error.max(initial=0.0))
    if np.any(additivity_error > _additivity_tolerance(prediction)):
        raise RuntimeError(
            f"OOF ensemble SHAP additivity failed; maximum error={maximum_error:.6g}"
        )
    seed_metrics = pd.DataFrame(seed_rows)
    mean_seed_metrics = {
        f"mean_seed_{metric}": float(seed_metrics[metric].mean())
        for metric in ("r2", "mae", "rmse")
    }
    mean_seed_metrics.update(
        {
            f"std_seed_{metric}": float(seed_metrics[metric].std(ddof=0))
            for metric in ("r2", "mae", "rmse")
        }
    )
    return OOFShapResult(
        prediction=prediction,
        prediction_std=prediction_std,
        shap_values=shap_values,
        base_value=base_value,
        coverage=coverage,
        model_registry=pd.DataFrame(registry_rows),
        seed_metrics=seed_metrics,
        ensemble_metrics=regression_metrics(target, prediction),
        mean_seed_metrics=mean_seed_metrics,
        max_additivity_error=maximum_error,
        seed_predictions=seed_predictions,
    )


