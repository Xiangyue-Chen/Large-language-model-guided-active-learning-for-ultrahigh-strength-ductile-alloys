def _plot_range_for_feature(feature: str) -> tuple[float, float] | None:
    name = str(feature)
    if name.startswith("phase_") and name.endswith("_volume_pct"):
        return VOLUME_FRACTION_PLOT_RANGE
    return None


def plot_range_masks(
    feature: str,
    values: np.ndarray | Sequence[float],
) -> tuple[np.ndarray, np.ndarray, np.ndarray]:
    numeric = np.asarray(values, dtype=float)
    finite = np.isfinite(numeric)
    allowed_range = _plot_range_for_feature(feature)
    excluded = np.zeros(numeric.shape, dtype=bool)
    if allowed_range is not None:
        lower, upper = allowed_range
        excluded = finite & ((numeric < lower) | (numeric > upper))
    return finite & ~excluded, ~finite, excluded


def build_plot_range_audit(dataset: TargetDataset) -> pd.DataFrame:
    columns = [
        "source_index_zero_based",
        "original_excel_row",
        "feature",
        "value",
        "allowed_min",
        "allowed_max",
        "reason",
    ]
    rows: list[dict[str, Any]] = []
    for feature in dataset.manifest["feature"].astype(str):
        allowed_range = _plot_range_for_feature(feature)
        if allowed_range is None:
            continue
        values = dataset.features[feature].to_numpy(dtype=float)
        _, _, excluded = plot_range_masks(feature, values)
        lower, upper = allowed_range
        for row_index in np.flatnonzero(excluded):
            rows.append(
                {
                    "source_index_zero_based": int(dataset.source_indices[row_index]),
                    "original_excel_row": int(dataset.excel_rows[row_index]),
                    "feature": feature,
                    "value": float(values[row_index]),
                    "allowed_min": float(lower),
                    "allowed_max": float(upper),
                    "reason": "outside_plot_range",
                }
            )
    return pd.DataFrame(rows, columns=columns)


def build_global_importance(
    result: OOFShapResult,
    dataset: TargetDataset,
) -> pd.DataFrame:
    absolute = np.abs(result.shap_values)
    values = dataset.features.to_numpy(dtype=float)
    table = dataset.manifest.copy()
    table["mean_abs_shap"] = absolute.mean(axis=0)
    table["std_abs_shap"] = absolute.std(axis=0, ddof=0)
    table["mean_shap"] = result.shap_values.mean(axis=0)
    table["finite_value_count"] = np.isfinite(values).sum(axis=0)
    table["missing_value_count"] = np.isnan(values).sum(axis=0)
    table["nonzero_value_count"] = (
        np.isfinite(values) & ~np.isclose(values, 0.0)
    ).sum(axis=0)
    table = table.sort_values("mean_abs_shap", ascending=False).reset_index(drop=True)
    table.insert(0, "importance_rank", np.arange(1, len(table) + 1, dtype=int))
    return table


def _apply_paper_axis_style(
    axis: plt.Axes,
    *,
    label_font_size: int = PLOT_AXIS_LABEL_FONT_SIZE,
    tick_font_size: int = PLOT_TICK_FONT_SIZE,
) -> None:
    axis.xaxis.label.set_fontsize(label_font_size)
    axis.xaxis.label.set_fontweight("bold")
    axis.yaxis.label.set_fontsize(label_font_size)
    axis.yaxis.label.set_fontweight("bold")
    axis.tick_params(
        axis="both",
        which="both",
        direction="in",
        labelsize=tick_font_size,
        length=5,
        width=1.0,
    )
    for tick_label in [*axis.get_xticklabels(), *axis.get_yticklabels()]:
        tick_label.set_fontweight("bold")
    axis.grid(False)


def _nice_endpoint_ticks(
    values: np.ndarray,
    *,
    include_zero: bool = False,
    max_intervals: int = 5,
) -> np.ndarray:
    finite = np.asarray(values, dtype=float)
    finite = finite[np.isfinite(finite)]
    if not finite.size:
        return np.array([], dtype=float)
    data_lower = float(finite.min())
    data_upper = float(finite.max())
    lower = min(data_lower, 0.0) if include_zero else data_lower
    upper = max(data_upper, 0.0) if include_zero else data_upper
    span = upper - lower
    padding = 0.03 * span if span > 0.0 else max(abs(lower) * 0.05, 1.0)
    padded_lower = lower - padding
    padded_upper = upper + padding
    locator = MaxNLocator(nbins=max_intervals, min_n_ticks=3)
    ticks = np.asarray(locator.tick_values(padded_lower, padded_upper), dtype=float)
    if data_lower >= 0.0:
        nonnegative = ticks[ticks >= 0.0]
        if nonnegative.size >= 2 and nonnegative[0] <= data_lower:
            ticks = nonnegative
    return ticks


def _set_dependence_endpoint_ticks(
    axis: plt.Axes,
    x_values: np.ndarray,
    y_values: np.ndarray,
) -> None:
    x_ticks = _nice_endpoint_ticks(x_values)
    y_ticks = _nice_endpoint_ticks(y_values, include_zero=True)
    if x_ticks.size >= 2:
        axis.set_xlim(float(x_ticks[0]), float(x_ticks[-1]))
        axis.set_xticks(x_ticks)
    if y_ticks.size >= 2:
        axis.set_ylim(float(y_ticks[0]), float(y_ticks[-1]))
        axis.set_yticks(y_ticks)


