class SavedEnsemblePrediction:
    prediction: np.ndarray
    prediction_std: np.ndarray
    shap_values: np.ndarray
    base_value: np.ndarray
    max_additivity_error: float
    model_count: int


@dataclass
class EnsembleContribution:
    prediction: np.ndarray
    shap_values: np.ndarray
    base_value: np.ndarray
    max_additivity_error: float


@lru_cache(maxsize=1)
def _pipeline_dependencies() -> dict[str, Any]:
    if not JOINT_SELECTION_SCRIPT.exists():
        raise FileNotFoundError(JOINT_SELECTION_SCRIPT)
    namespace = runpy.run_path(str(JOINT_SELECTION_SCRIPT))
    required = {
        "DATA_FILE",
        "load_workbook_data",
        "load_physical_prefix",
        "make_starting_matrix",
        "build_combined_candidates",
        "PHASE_COLUMN",
    }
    missing = required.difference(namespace)
    if missing:
        raise RuntimeError(f"joint selection module is missing interfaces: {sorted(missing)}")
    return namespace


