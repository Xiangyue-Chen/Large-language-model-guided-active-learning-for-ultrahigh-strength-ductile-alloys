            {"setting": "final_epochs", "value": FINAL_EPOCHS},
            {"setting": "one_global_parameter_set", "value": True},
            {"setting": "test_folds_used_for_global_bo", "value": True},
            {
                "setting": "bo_uses_seed42_folds_only",
