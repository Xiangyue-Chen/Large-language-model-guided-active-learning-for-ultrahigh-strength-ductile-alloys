def resolve_device():
    requested = os.getenv("ANN_DEVICE", "").strip()
    if requested:
        device = torch.device(requested)
        if device.type == "cuda" and not torch.cuda.is_available():
            raise RuntimeError(f"ANN_DEVICE={requested} requested unavailable CUDA.")
        return device
    return torch.device("cuda" if torch.cuda.is_available() else "cpu")


def set_seed(seed):
    random.seed(seed)
    np.random.seed(seed)
    torch.manual_seed(seed)
    if torch.cuda.is_available():
        torch.cuda.manual_seed_all(seed)


def metric_values(y_true, y_pred):
    mse = mean_squared_error(y_true, y_pred)
    return {
        "r2": float(r2_score(y_true, y_pred)),
        "mae": float(mean_absolute_error(y_true, y_pred)),
        "mse": float(mse),
        "rmse": float(math.sqrt(mse)),
    }


def convert_parameters(raw):
    batch_index = min(
        len(BATCH_CANDIDATES) - 1,
        max(0, int(round(raw["batch_index"]))),
    )
    return {
        "hidden_width": min(384, max(64, int(round(raw["hidden_width"])))),
        "depth": min(5, max(1, int(round(raw["depth"])))),
        "dropout": min(0.30, max(0.0, float(raw["dropout"]))),
        "learning_rate": float(10.0 ** raw["log10_learning_rate"]),
        "weight_decay": float(10.0 ** raw["log10_weight_decay"]),
        "batch_size": int(BATCH_CANDIDATES[batch_index]),
    }


class MLP(nn.Module):
    def __init__(self, input_dim, hidden_width, depth, dropout):
        super().__init__()
        layers = []
        current_width = input_dim
        for _ in range(depth):
            linear = nn.Linear(current_width, hidden_width)
            nn.init.kaiming_normal_(linear.weight, nonlinearity="relu")
            nn.init.zeros_(linear.bias)
            layers.extend(
                [
                    linear,
                    nn.BatchNorm1d(hidden_width),
                    nn.ReLU(),
                    nn.Dropout(dropout),
                ]
            )
            current_width = hidden_width
        output = nn.Linear(current_width, 1)
        nn.init.kaiming_normal_(output.weight, nonlinearity="linear")
        nn.init.zeros_(output.bias)
        layers.append(output)
        self.network = nn.Sequential(*layers)

    def forward(self, inputs):
        return self.network(inputs)


def load_data():
    frame = pd.read_excel(FILE)
    required_column = max(INPUT_SLICE.stop - 1, TARGET_COL)
    if frame.shape[1] <= required_column:
        raise ValueError(
            f"The dataset has {frame.shape[1]} columns; column index "
            f"{required_column} is required."
        )

    numeric_target = pd.to_numeric(frame.iloc[:, TARGET_COL], errors="coerce")
    valid_target = numeric_target.notna()
    frame = frame.loc[valid_target].copy()
    y = numeric_target.loc[valid_target].to_numpy(dtype=np.float32)
    excel_rows = frame.index.to_numpy(dtype=int) + 2
    X_frame = frame.iloc[:, INPUT_SLICE].apply(pd.to_numeric, errors="coerce")
    X_raw = X_frame.fillna(0.0).to_numpy(dtype=float)

    if len(y) < 2:
        raise ValueError("At least two valid target rows are required.")
    if not np.isfinite(X_raw).all() or not np.isfinite(y).all():
        raise ValueError("The numeric input or target contains non-finite values.")

    scaler = StandardScaler()
    X_scaled = scaler.fit_transform(X_raw).astype(np.float32)
    with SCALER_PATH.open("wb") as handle:
        pickle.dump(scaler, handle)
    return X_scaled, y, excel_rows, scaler


def make_cv_splits(X_scaled, seeds, n_splits):
    if n_splits < 2 or n_splits > len(X_scaled):
        raise ValueError(
            f"n_splits must be between 2 and {len(X_scaled)}, got {n_splits}."
        )
    split_records = []
    for seed in seeds:
        splitter = KFold(n_splits=n_splits, shuffle=True, random_state=seed)
        for fold, (train_idx, test_idx) in enumerate(
            splitter.split(X_scaled), start=1
        ):
            split_records.append(
                {
                    "seed": int(seed),
                    "fold": int(fold),
                    "train_idx": train_idx,
                    "test_idx": test_idx,
                }
            )
    return split_records


def make_epoch_batches(sample_count, batch_size, generator):
    if sample_count < 2:
        raise ValueError("BatchNorm requires at least two training samples.")
    order = torch.randperm(sample_count, generator=generator)
    chunks = list(order.split(min(batch_size, sample_count)))
    if len(chunks) > 1 and len(chunks[-1]) == 1:
        chunks[-2] = torch.cat([chunks[-2], chunks[-1]])
        chunks.pop()
    return chunks


def train_fold_network(
    X_train,
    y_train,
    X_test,
    y_test,
    params,
    epochs,
    training_seed,
    device,
    capture_state,
):
    set_seed(training_seed)
    model = MLP(
        input_dim=X_train.shape[1],
        hidden_width=params["hidden_width"],
        depth=params["depth"],
        dropout=params["dropout"],
    ).to(device)
    optimizer = torch.optim.AdamW(
        model.parameters(),
        lr=params["learning_rate"],
        weight_decay=params["weight_decay"],
    )
    loss_function = nn.MSELoss()
    X_train_tensor = torch.as_tensor(X_train, dtype=torch.float32, device=device)
    y_train_tensor = torch.as_tensor(
        y_train.reshape(-1, 1), dtype=torch.float32, device=device
    )
    X_test_tensor = torch.as_tensor(X_test, dtype=torch.float32, device=device)
    batch_generator = torch.Generator(device="cpu")
    batch_generator.manual_seed(training_seed)

    best_test_r2 = -np.inf
    best_epoch = 0
    best_train_metrics = None
    best_test_metrics = None
    best_train_prediction = None
    best_test_prediction = None
    best_state = None

    for epoch in range(1, epochs + 1):
        model.train()
        batches = make_epoch_batches(
            len(X_train), params["batch_size"], batch_generator
        )
        for batch_indices_cpu in batches:
            batch_indices = batch_indices_cpu.to(device)
            optimizer.zero_grad(set_to_none=True)
            prediction = model(X_train_tensor[batch_indices])
            loss = loss_function(prediction, y_train_tensor[batch_indices])
            if not torch.isfinite(loss):
                raise FloatingPointError(
                    f"Non-finite training loss at epoch {epoch}."
                )
            loss.backward()
            optimizer.step()

        model.eval()
        with torch.no_grad():
            train_prediction = (
                model(X_train_tensor).squeeze(1).detach().cpu().numpy()
            )
            test_prediction = (
                model(X_test_tensor).squeeze(1).detach().cpu().numpy()
            )
        train_metrics = metric_values(y_train, train_prediction)
        test_metrics = metric_values(y_test, test_prediction)
        if test_metrics["r2"] > best_test_r2:
            best_test_r2 = test_metrics["r2"]
            best_epoch = epoch
            best_train_metrics = train_metrics
            best_test_metrics = test_metrics
            best_train_prediction = train_prediction.copy()
            best_test_prediction = test_prediction.copy()
            if capture_state:
                best_state = {
                    name: tensor.detach().cpu().clone()
                    for name, tensor in model.state_dict().items()
                }

    if best_epoch == 0:
        raise RuntimeError("No finite best test epoch was recorded.")
    if capture_state and best_state is None:
        raise RuntimeError("The requested best-epoch state was not captured.")

    del model
    if device.type == "cuda":
        torch.cuda.empty_cache()
    return {
        "best_epoch": best_epoch,
        "train_metrics": best_train_metrics,
        "test_metrics": best_test_metrics,
        "train_prediction": best_train_prediction,
        "test_prediction": best_test_prediction,
        "state_dict": best_state,
    }


def run_global_bayesian_optimization(X_scaled, y, split_records, device):
    trial_records = []
    fold_detail_records = []
    trial_number = 0
    total_trials = INIT_POINTS + NUM_ITER

    def objective(**raw_parameters):
        nonlocal trial_number
        trial_number += 1
        started = time.perf_counter()
        params = convert_parameters(raw_parameters)
        parameters_json = json.dumps(
            params, ensure_ascii=False, sort_keys=True
        )
        raw_parameters_json = json.dumps(
            raw_parameters, ensure_ascii=False, sort_keys=True
        )
        fold_r2 = []
        fold_rmse = []
        errors = []

        for split in split_records:
            seed = split["seed"]
            fold = split["fold"]
            train_idx = split["train_idx"]
            test_idx = split["test_idx"]
            training_seed = seed * 100 + fold
            detail = {
                "trial": trial_number,
                "seed": seed,
                "fold": fold,
                "train_samples": len(train_idx),
                "test_samples": len(test_idx),
                "parameters_json": parameters_json,
            }
            try:
                result = train_fold_network(
                    X_scaled[train_idx],
                    y[train_idx],
                    X_scaled[test_idx],
                    y[test_idx],
                    params,
                    BO_EPOCHS,
                    training_seed,
                    device,
                    capture_state=False,
                )
                train_metrics = result["train_metrics"]
                test_metrics = result["test_metrics"]
                detail.update(
                    {f"train_{key}": value for key, value in train_metrics.items()}
                )
                detail.update(
                    {f"test_{key}": value for key, value in test_metrics.items()}
                )
                detail["best_epoch"] = result["best_epoch"]
                detail["error"] = ""
                fold_r2.append(test_metrics["r2"])
                fold_rmse.append(test_metrics["rmse"])
            except Exception as exc:
                error = f"{type(exc).__name__}: {exc}"
                detail.update(
                    {
                        "train_r2": np.nan,
                        "train_mae": np.nan,
                        "train_mse": np.nan,
                        "train_rmse": np.nan,
                        "test_r2": np.nan,
                        "test_mae": np.nan,
                        "test_mse": np.nan,
                        "test_rmse": np.nan,
                        "best_epoch": np.nan,
                        "error": error,
                    }
                )
                errors.append(f"seed={seed}, fold={fold}: {error}")
            fold_detail_records.append(detail)

        elapsed = time.perf_counter() - started
        if errors or len(fold_r2) != len(split_records):
            mean_test_r2 = -1.0e12
            mean_test_rmse = np.nan
            error_text = " | ".join(errors[:3])
        else:
            mean_test_r2 = float(np.mean(fold_r2))
            mean_test_rmse = float(np.mean(fold_rmse))
            error_text = ""
        trial_records.append(
            {
                "trial": trial_number,
                "mean_test_r2": mean_test_r2,
                "mean_test_rmse": mean_test_rmse,
                "fold_count": len(fold_r2),
                "elapsed_seconds": elapsed,
                "parameters_json": parameters_json,
                "raw_parameters_json": raw_parameters_json,
                "error": error_text,
            }
        )
        rmse_text = (
            f"{mean_test_rmse:.6f}" if np.isfinite(mean_test_rmse) else "nan"
        )
        print(
            f"[Global BO {trial_number}/{total_trials}] "
            f"mean_test_r2={mean_test_r2:.6f}, "
            f"mean_test_rmse={rmse_text}, elapsed={elapsed:.2f}s, "
            f"params={parameters_json}",
            flush=True,
        )
        return mean_test_r2

    optimizer = BayesianOptimization(
        f=objective,
        pbounds=PBOUNDS,
        random_state=BO_RANDOM_STATE,
        verbose=0,
        allow_duplicate_points=True,
    )
    optimizer.maximize(init_points=INIT_POINTS, n_iter=NUM_ITER)
    successful = [record for record in trial_records if not record["error"]]
    if not successful:
        errors = "; ".join(record["error"] for record in trial_records[:3])
        raise RuntimeError(f"All global BO candidates failed: {errors}")
    best_trial = max(successful, key=lambda record: record["mean_test_r2"])
    best_params = json.loads(best_trial["parameters_json"])
    return (
        best_params,
        best_trial,
        pd.DataFrame(trial_records),
        pd.DataFrame(fold_detail_records),
    )


def fit_final_folds(
    X_scaled,
    y,
    excel_rows,
    scaler,
    split_records,
    best_params,
    device,
):
    parameters_json = json.dumps(
        best_params, ensure_ascii=False, sort_keys=True
    )
    fold_records = []
    prediction_frames = []
    fold_artifacts = {}
    total = len(split_records)

    for number, split in enumerate(split_records, start=1):
        seed = split["seed"]
        fold = split["fold"]
        train_idx = split["train_idx"]
        test_idx = split["test_idx"]
        training_seed = seed * 100 + fold
        started = time.perf_counter()
        result = train_fold_network(
            X_scaled[train_idx],
            y[train_idx],
            X_scaled[test_idx],
            y[test_idx],
            best_params,
            FINAL_EPOCHS,
            training_seed,
            device,
            capture_state=True,
        )
        elapsed = time.perf_counter() - started
        model_path = MODEL_SAVE_DIR / f"seed_{seed}_fold_{fold}.pt"
        torch.save(
            {
                "state_dict": result["state_dict"],
                "input_dim": int(X_scaled.shape[1]),
                "parameters": best_params,
                "parameters_json": parameters_json,
                "seed": seed,
                "fold": fold,
                "best_epoch": result["best_epoch"],
                "target_name": TARGET_NAME,
                "train_indices": train_idx,
                "test_indices": test_idx,
                "train_metrics": result["train_metrics"],
                "test_metrics": result["test_metrics"],
                "one_global_parameter_set": True,
                "test_folds_used_for_global_bo": (
                    seed == BO_SELECTION_SEED
                ),
                "bo_uses_seed42_folds_only": BO_SELECTION_SEED == 42,
                "seed42_test_folds_used_for_global_bo": True,
                "all_final_test_folds_used_for_global_bo": False,
                "test_fold_used_for_epoch_selection": True,
                "preprocessing_fit_scope": "full_target_dataset_before_cv",
                "target_scaled": False,
            },
            model_path,
        )
        record = {
            "seed": seed,
            "fold": fold,
            "train_samples": len(train_idx),
            "test_samples": len(test_idx),
            "best_epoch": result["best_epoch"],
            "parameters_json": parameters_json,
            "model_path": str(model_path),
            "elapsed_seconds": elapsed,
        }
        record.update(
            {
                f"train_{key}": value
                for key, value in result["train_metrics"].items()
            }
        )
        record.update(
            {
                f"test_{key}": value
                for key, value in result["test_metrics"].items()
            }
        )
        fold_records.append(record)
        prediction_frame = pd.DataFrame(
            {
                "seed": seed,
                "fold": fold,
                "best_epoch": result["best_epoch"],
                "original_excel_row": excel_rows[test_idx],
                "true_value": y[test_idx],
                "predicted_value": result["test_prediction"],
                "parameters_json": parameters_json,
            }
        )
        prediction_frame["residual"] = (
            prediction_frame["predicted_value"]
            - prediction_frame["true_value"]
        )
        prediction_frame["abs_error"] = prediction_frame["residual"].abs()
        prediction_frames.append(prediction_frame)
        fold_artifacts[(seed, fold)] = {
            "train_idx": train_idx,
            "test_idx": test_idx,
            "train_prediction": result["train_prediction"],
            "test_prediction": result["test_prediction"],
            "best_epoch": result["best_epoch"],
        }
        print(
            f"[Final fold {number}/{total}] seed={seed}, fold={fold}, "
            f"best_epoch={result['best_epoch']}, "
            f"test_r2={result['test_metrics']['r2']:.6f}, "
            f"test_rmse={result['test_metrics']['rmse']:.6f}",
            flush=True,
        )

    return (
        pd.DataFrame(fold_records).sort_values(["seed", "fold"]),
        pd.concat(prediction_frames, ignore_index=True),
        fold_artifacts,
    )


