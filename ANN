                "setting": "bo_selection_seed",
                "value": BO_SELECTION_SEED,
            },
            {
                "setting": "bo_selection_n_splits",
                "value": BO_SELECTION_N_SPLITS,
            },
            {
                "setting": "bo_selection_fold_count",
                "value": len(bo_split_records),
            },
            {
