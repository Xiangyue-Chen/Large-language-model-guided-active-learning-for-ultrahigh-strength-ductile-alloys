def build_sample_prediction_summary(predictions):
    grouped = predictions.groupby("original_excel_row", sort=True)
    summary = grouped.agg(
        true_value=("true_value", "first"),
        prediction_mean=("predicted_value", "mean"),
        prediction_std=("predicted_value", lambda values: values.std(ddof=1)),
        prediction_variance=(
            "predicted_value", lambda values: values.var(ddof=1)
        ),
        prediction_count=("predicted_value", "size"),
    ).reset_index()
    summary["prediction_std"] = summary["prediction_std"].fillna(0.0)
    summary["prediction_variance"] = summary["prediction_variance"].fillna(0.0)
    summary["mean_residual"] = summary["prediction_mean"] - summary["true_value"]
    summary["mean_abs_error"] = summary["mean_residual"].abs()
    return summary


def save_mean_std_scatter(sample_summary, overall):
    y_true = sample_summary["true_value"].to_numpy()
    y_mean = sample_summary["prediction_mean"].to_numpy()
    y_std = sample_summary["prediction_std"].to_numpy()
    lower = min(float(y_true.min()), float(y_mean.min()))
    upper = max(float(y_true.max()), float(y_mean.max()))
    padding = max((upper - lower) * 0.04, 1.0e-6)
    fig, ax = plt.subplots(figsize=(8.5, 7.5))
    ax.errorbar(
        y_true,
        y_mean,
        yerr=y_std,
        fmt="none",
        ecolor="#8c99a4",
        elinewidth=0.45,
        alpha=0.22,
        capsize=0,
        zorder=1,
    )
    points = ax.scatter(
        y_true,
        y_mean,
        c=y_std,
        cmap="viridis",
        s=18,
        alpha=0.72,
        edgecolors="none",
        zorder=2,
        label="Mean test prediction",
    )
    ax.plot(
        [lower - padding, upper + padding],
        [lower - padding, upper + padding],
        "r--",
        linewidth=1.5,
        label="Ideal",
        zorder=3,
    )
    sample_mean_r2 = r2_score(y_true, y_mean)
    fold_mean_r2 = overall.loc[0, "mean_r2_50"]
    fold_std_r2 = overall.loc[0, "std_r2_50"]
    colorbar = fig.colorbar(points, ax=ax)
    colorbar.set_label("Prediction standard deviation")
    ax.set_xlabel(f"Measured {TARGET_NAME}")
    ax.set_ylabel(f"Mean test prediction of {TARGET_NAME}")
    ax.set_title(
        f"ANN: sample mean R2={sample_mean_r2:.4f}; "
        f"fold R2={fold_mean_r2:.4f} +/- {fold_std_r2:.4f}\n"
        "Error bars show +/- 1 prediction standard deviation"
    )
    ax.grid(alpha=0.25)
    ax.legend()
    fig.tight_layout()
    fig.savefig(BEST_MODEL_SCATTER_PATH, dpi=300)
    plt.close(fig)


def save_seed_best_fold_plots(final_folds, fold_artifacts, y):
    SEED_BEST_PLOT_DIR.mkdir(parents=True, exist_ok=True)
    best_rows = (
        final_folds.sort_values(["seed", "test_r2"], ascending=[True, False])
        .groupby("seed", sort=True, as_index=False)
        .head(1)
        .sort_values("seed")
    )
    records = []
    for _, row in best_rows.iterrows():
        seed = int(row["seed"])
        fold = int(row["fold"])
        artifact = fold_artifacts[(seed, fold)]
        train_idx = artifact["train_idx"]
        test_idx = artifact["test_idx"]
        train_prediction = artifact["train_prediction"]
        test_prediction = artifact["test_prediction"]
        train_metrics = metric_values(y[train_idx], train_prediction)
        test_metrics = metric_values(y[test_idx], test_prediction)
        all_true = np.concatenate([y[train_idx], y[test_idx]])
        all_prediction = np.concatenate([train_prediction, test_prediction])
        lower = min(float(all_true.min()), float(all_prediction.min()))
        upper = max(float(all_true.max()), float(all_prediction.max()))
        padding = max((upper - lower) * 0.04, 1.0e-6)
        fig, ax = plt.subplots(figsize=(8, 7))
        ax.scatter(
            y[train_idx],
            train_prediction,
            s=18,
            alpha=0.48,
            color="#2878b5",
            label=f"Train (R2={train_metrics['r2']:.4f})",
        )
        ax.scatter(
            y[test_idx],
            test_prediction,
            s=26,
            alpha=0.78,
            color="#d95f02",
            label=f"Test (R2={test_metrics['r2']:.4f})",
        )
        ax.plot(
            [lower - padding, upper + padding],
            [lower - padding, upper + padding],
            "k--",
            linewidth=1.4,
            label="Ideal",
        )
        ax.set_xlabel(f"Measured {TARGET_NAME}")
        ax.set_ylabel(f"Predicted {TARGET_NAME}")
        ax.set_title(
            f"Seed {seed}, best fold {fold}, epoch {artifact['best_epoch']}"
        )
        ax.grid(alpha=0.25)
        ax.legend()
        fig.tight_layout()
        plot_path = SEED_BEST_PLOT_DIR / f"seed_{seed}_best_fold_{fold}.png"
        fig.savefig(plot_path, dpi=300)
        if seed == 42:
            fig.savefig(SEED42_BEST_FOLD_PATH, dpi=300)
        plt.close(fig)
        records.append(
            {
                "seed": seed,
                "best_fold": fold,
                "best_epoch": artifact["best_epoch"],
                "train_r2": train_metrics["r2"],
                "train_mae": train_metrics["mae"],
                "train_rmse": train_metrics["rmse"],
                "test_r2": test_metrics["r2"],
                "test_mae": test_metrics["mae"],
                "test_rmse": test_metrics["rmse"],
                "plot_path": str(plot_path),
                "seed42_separate_plot": seed == 42,
            }
        )
    return pd.DataFrame(records)


def main():
    OUTPUT_DIR.mkdir(parents=True, exist_ok=True)
    MODEL_SAVE_DIR.mkdir(parents=True, exist_ok=True)
    device = resolve_device()
    set_seed(BO_RANDOM_STATE)
    X_scaled, y, excel_rows, scaler = load_data()
    final_seeds = active_final_seeds()
    final_n_splits = active_final_n_splits()
    bo_split_records = make_cv_splits(
        X_scaled,
        [BO_SELECTION_SEED],
        BO_SELECTION_N_SPLITS,
    )
    final_split_records = make_cv_splits(
        X_scaled,
        final_seeds,
        final_n_splits,
    )
    print(
        f"[ANN | {TARGET_NAME}] Global Bayesian optimization: "
        f"{INIT_POINTS + NUM_ITER} candidates x "
        f"seed {BO_SELECTION_SEED}/{len(bo_split_records)} folds x "
        f"{BO_EPOCHS} epochs; final repeated CV="
        f"{len(final_seeds)} x {final_n_splits}; device={device}",
        flush=True,
    )
    best_params, best_trial, trials, bo_fold_details = (
        run_global_bayesian_optimization(
            X_scaled, y, bo_split_records, device
        )
    )
    final_folds, predictions, fold_artifacts = fit_final_folds(
        X_scaled,
        y,
        excel_rows,
        scaler,
        final_split_records,
        best_params,
        device,
    )

    expected_folds = len(final_seeds) * final_n_splits
    if len(final_folds) != expected_folds:
        raise AssertionError(
            f"Expected {expected_folds} final folds, got {len(final_folds)}."
        )
    if final_folds["parameters_json"].nunique() != 1:
        raise AssertionError("Final folds do not share one global parameter set.")
    overall = summarize_final_folds(final_folds)
    sample_summary = build_sample_prediction_summary(predictions)
    if (
        final_seeds == FINAL_CV_SEEDS
        and final_n_splits == FINAL_N_SPLITS
    ):
        if not sample_summary["prediction_count"].eq(len(FINAL_CV_SEEDS)).all():
            raise AssertionError("Every sample must have 10 final test predictions.")
    seed_best_folds = save_seed_best_fold_plots(final_folds, fold_artifacts, y)
    global_best = pd.DataFrame(
        [
            {
                "model": MODEL_NAME,
                "target": TARGET_NAME,
                "best_trial": int(best_trial["trial"]),
                "bo_selection_seed": BO_SELECTION_SEED,
                "bo_selection_fold_count": len(bo_split_records),
                "mean_test_r2": best_trial["mean_test_r2"],
                "mean_test_rmse": best_trial["mean_test_rmse"],
                "parameters_json": json.dumps(
                    best_params, ensure_ascii=False, sort_keys=True
                ),
                **best_params,
            }
        ]
    )
    configuration = pd.DataFrame(
        [
            {"setting": "file", "value": str(FILE)},
            {"setting": "target", "value": TARGET_NAME},
            {"setting": "model", "value": MODEL_NAME},
            {"setting": "device", "value": str(device)},
