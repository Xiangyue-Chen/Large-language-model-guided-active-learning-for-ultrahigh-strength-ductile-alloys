COMBINED_PROMPT = PRIMARY_PROMPT + (
    "\n\nReturn JSON only (an object or an array), with no other text. "
    "JSON must strictly follow standard syntax. Use double quotes for "
    "property names. Strings containing %, nm, or °C must be quoted."
)


DEBUG_DIR = "./debug_out"
JSON_OUT = "./json_out"
SLEEP_EACH = 0.4


def fix_json(text: str) -> str:
    text = text.strip()
    text = re.sub(r"^\x60{3}(?:json)?\s*|\s*\x60{3}$", "", text).strip()
    try:
        json.loads(text)
        return text
    except json.JSONDecodeError:
        pass

    try:
        literal = ast.literal_eval(text)
        if isinstance(literal, (dict, list)):
            return json.dumps(literal, ensure_ascii=False, allow_nan=False)
    except (ValueError, SyntaxError, TypeError):
        pass

    quoted = r'"(?:\\.|[^"\\])*"'
    text = re.sub(
        quoted + r"|,\s*(?=[}\]])",
        lambda match: match.group(0) if match.group(0).startswith('"') else "",
        text,
    )
    text = re.sub(
        quoted + r"|(?<=[{,])\s*([A-Za-z_]\w*)\s*:",
        lambda match: (
            match.group(0) if match.group(1) is None
            else f'"{match.group(1)}":'
        ),
        text,
    )
    text = re.sub(
        quoted + r"|(:\s*)(-?\d+(?:\.\d+)?)\s*(MPa|GPa|°C|μm|nm|%|h)(?=\s*[,}\]])",
        lambda match: (
            match.group(0) if match.group(1) is None
            else f'{match.group(1)}"{match.group(2)} {match.group(3)}"'
        ),
        text,
    )

    decoder = json.JSONDecoder()
    objects = []
    remaining = text
    try:
        while remaining.strip():
            item, end = decoder.raw_decode(remaining.lstrip())
            objects.append(item)
            remaining = remaining.lstrip()[end:]
    except json.JSONDecodeError:
        return text
    if len(objects) > 1 and all(isinstance(item, dict) for item in objects):
        return json.dumps(objects, ensure_ascii=False, allow_nan=False)
    return text


def extract_and_to_json(
    pdf_path: Union[str, Path],
    base_name: str,
    analyze_pdf: PdfAnalyzer,
    debug_dir: Union[str, Path] = DEBUG_DIR,
) -> Any:
    if not callable(analyze_pdf):
        raise TypeError("PDF analyzer is not callable.")

    raw_json_text = analyze_pdf(Path(pdf_path), COMBINED_PROMPT)
    if not isinstance(raw_json_text, str):
        raise TypeError("PDF analyzer must return a JSON string.")

    debug_path = Path(debug_dir)
    debug_path.mkdir(parents=True, exist_ok=True)
    (debug_path / f"{base_name}__raw_json.txt").write_text(
        raw_json_text, encoding="utf-8"
    )
    if not raw_json_text.strip():
        raise ValueError("Empty analyzer response.")

    cleaned = re.sub(
        r"^\x60{3}(?:json)?\s*|\s*\x60{3}$",
        "",
        raw_json_text.strip(),
    ).strip()
    try:
        data = json.loads(cleaned)
    except json.JSONDecodeError:
        print("Invalid JSON; attempting formatting repair.")
        fixed = fix_json(cleaned)
        (debug_path / f"{base_name}__fixed_json.txt").write_text(
            fixed, encoding="utf-8"
        )
        try:
            data = json.loads(fixed)
        except json.JSONDecodeError as error:
            raise ValueError(
                f"Invalid JSON; raw response: "
                f"{debug_path / (base_name + '__raw_json.txt')}."
            ) from error

    if not isinstance(data, (dict, list)):
        raise ValueError("The response must be a JSON object or array.")
    if isinstance(data, list) and not all(isinstance(item, dict) for item in data):
        raise ValueError("Every item in a record array must be a JSON object.")
    return data


def process_pdf(
    pdf_path: Union[str, Path],
    out_json_dir: Union[str, Path],
    analyze_pdf: PdfAnalyzer,
    debug_dir: Union[str, Path] = DEBUG_DIR,
) -> Any:
    pdf_path = Path(pdf_path)
    pdf_size = pdf_path.stat().st_size
    print(f"Processing {pdf_path.name}: PDF size {pdf_size / 1024 / 1024:.2f} MB")

    data = extract_and_to_json(
        pdf_path, pdf_path.stem, analyze_pdf, debug_dir=debug_dir
    )
    out_json_dir = Path(out_json_dir)
    out_json_dir.mkdir(parents=True, exist_ok=True)
    if isinstance(data, list):
        for index, item in enumerate(data, 1):
            out_path = out_json_dir / f"{pdf_path.stem}_{index}.json"
            out_path.write_text(
                json.dumps(item, ensure_ascii=False, indent=2), encoding="utf-8"
            )
    else:
        out_path = out_json_dir / f"{pdf_path.stem}.json"
        out_path.write_text(
            json.dumps(data, ensure_ascii=False, indent=2), encoding="utf-8"
        )
    return data


def process_folder(
    input_dir: Union[str, Path],
    json_out_dir: Union[str, Path],
    analyze_pdf: PdfAnalyzer,
    debug_dir: Union[str, Path] = DEBUG_DIR,
    sleep_each: float = SLEEP_EACH,
) -> Dict[str, int]:
    input_path = Path(input_dir)
    if not input_path.is_dir():
        raise NotADirectoryError(f"Input folder does not exist: {input_path}")
    if not callable(analyze_pdf):
        raise TypeError("PDF analyzer is not callable.")

    pdfs = sorted(
        path for path in input_path.iterdir()
        if path.is_file() and path.suffix.lower() == ".pdf"
    )
    summary = {"processed": 0, "failed": 0}
    if not pdfs:
        print(f"No PDF files found in {input_path}")
        return summary

    for index, pdf_path in enumerate(pdfs, 1):
        print(f"[{index}/{len(pdfs)}]")
        try:
            process_pdf(pdf_path, json_out_dir, analyze_pdf, debug_dir=debug_dir)
            summary["processed"] += 1
        except Exception as error:
            print(f"Failed to process {pdf_path.name}: {error}")
            summary["failed"] += 1
        time.sleep(sleep_each)

    print(f"JSON output directory: {Path(json_out_dir).absolute()}")
    print(f"Debug output directory: {Path(debug_dir).absolute()}")
    print(f"Processed: {summary['processed']}; failed: {summary['failed']}")
    return summary


def main() -> int:
    parser = argparse.ArgumentParser(
        description="HEA literature extraction."
    )
    parser.add_argument("input_dir", nargs="?", help="Folder containing PDF files.")
    parser.add_argument(
        "--adapter",
        help="PDF analyzer: module:function (pdf_path, prompt).",
    )
    parser.add_argument("--json-out", default=JSON_OUT, help="JSON output folder.")
    parser.add_argument("--debug-dir", default=DEBUG_DIR, help="Raw response folder.")
    parser.add_argument(
        "--export-prompt", metavar="FILE", help="Export the English prompt only."
    )
    args = parser.parse_args()

    if args.export_prompt:
        destination = Path(args.export_prompt)
        destination.parent.mkdir(parents=True, exist_ok=True)
        destination.write_text(COMBINED_PROMPT.strip() + "\n", encoding="utf-8")
        print(f"English extraction prompt saved to: {destination.absolute()}")
        return 0

    if not args.input_dir:
        parser.error("Specify an input folder or use --export-prompt.")
    if not args.adapter:
        parser.error(
            "No analyzer is configured. Supply --adapter module:function, "
            "or import process_folder and pass an analyzer callable."
        )

    module_name, separator, function_name = args.adapter.partition(":")
    if not separator or not module_name or not function_name:
        parser.error("--adapter must use the form module:function.")
    try:
        module = importlib.import_module(module_name)
        analyze_pdf = getattr(module, function_name)
        if not callable(analyze_pdf):
            parser.error("The selected adapter is not callable.")
        summary = process_folder(
            args.input_dir, args.json_out, analyze_pdf, debug_dir=args.debug_dir
        )
    except (ImportError, AttributeError, OSError, TypeError) as error:
        parser.error(str(error))
    return 1 if summary["failed"] else 0


if __name__ == "__main__":
    raise SystemExit(main())
